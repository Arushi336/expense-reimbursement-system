# ═══════════════════════════════════════════════════════════════
# EERS - Enterprise Employee Expense Reimbursement System
# Environment Configuration Template
# ═══════════════════════════════════════════════════════════════
# IMPORTANT: Copy this file to .env and fill in actual values.
# NEVER commit .env files with real credentials to version control.
# ═══════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ─────────────────────────────────────────────────
# REQUIRED in production. No fallback allowed.
MONGO_URI=mongodb://127.0.0.1:27017/eers

# ── JWT Authentication ───────────────────────────────────────
# REQUIRED in production. Must be strong, unique secrets.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_GENERATE_STRONG_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_STRONG_REFRESH_SECRET
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173

# ── Email / SMTP Configuration ──────────────────────────────
# REQUIRED in production when SMTP_ENABLED is not 'false'
# For Gmail: use App Password (not account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=EERS Notification

# Set to 'false' to skip SMTP requirement check in production
# SMTP_ENABLED=false

# ── Cloudinary (File Storage) ────────────────────────────────
# Set CLOUDINARY_ENABLED=true and provide credentials for cloud storage
# CLOUDINARY_ENABLED=true
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# ── Frontend ─────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:5000/api
