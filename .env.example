# See backend/.env.example for full documentation
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/eers
JWT_SECRET=CHANGE_ME_GENERATE_STRONG_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_STRONG_REFRESH_SECRET
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=EERS Notification
VITE_API_BASE_URL=http://localhost:5000/api
